MEMORY
{
  FLASH : ORIGIN = 0x00000000, LENGTH = 960K
  RAM : ORIGIN = 0x200A0000, LENGTH = 896K

  USR_1 : ORIGIN = 0x08000000, LENGTH = 960K
  SYS_1 : ORIGIN = 0x1FFF0000, LENGTH = 56K
  VND : ORIGIN = 0x1FFFF700, LENGTH = 256
  OPT : ORIGIN = 0x1FFFF800, LENGTH = 256
  ITCM : ORIGIN = 0x200A0000, LENGTH = 128K
  DTCM : ORIGIN = 0x200C0000, LENGTH = 256K
  SRAM_SHARED : ORIGIN = 0x20100000, LENGTH = 512K
}

REGION_ALIAS("REGION_TEXT", FLASH);
REGION_ALIAS("REGION_RODATA", FLASH);
REGION_ALIAS("REGION_DATA", RAM);
REGION_ALIAS("REGION_BSS", RAM);
REGION_ALIAS("REGION_HEAP", RAM);
REGION_ALIAS("REGION_STACK", RAM);

_max_hart_id = 1;

INCLUDE interrupts.x
